# Database Configuration
POSTGRES_VERSION=18-alpine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecm_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Redis Configuration
REDIS_VERSION=7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
POSTGRES_VOLUME_NAME=ecm-postgres-v2
REDIS_VOLUME_NAME=ecm-redis

# Server Configuration
PORT=8080
SHOW_SQL=false

# Local media upload (admin catalog images and authenticated profile avatars)
FILE_STORAGE_DIR=./var/uploads
FILE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files
FILE_MAX_SIZE=10MB
FILE_MAX_REQUEST_SIZE=12MB
FILE_MAX_SIZE_BYTES=10485760

# JWT Configuration
# Secret must be Base64-encoded and decode to at least 32 bytes.
JWT_SECRET_KEY=dGhpc19pc19hX3Zlcnlfc2VjdXJlX2tleV9mb3Jfand0X3NpZ25pbmdfYXV0aGVudGljYXRpb25fMjAyNg==
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Google Identity Services (optional; required to enable POST /auth/google)
GOOGLE_CLIENT_ID=

# Mail Configuration (required for real OTP delivery; local OTP is stored in Redis)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Stripe Configuration (optional for local mock payment flow)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
